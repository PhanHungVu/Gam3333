# This .gitignore should be placed at the root of your Unity project.
#
# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Memory captures
/[Mm]emoryCaptures/

# Recordings
/[Rr]ecordings/

# Asset Store tools
/[Aa]ssets/AssetStoreTools*

# Visual Studio cache
.vs/

# Visual Studio generated files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity-generated debugging files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# JetBrains Rider
.idea/
*.sln.iml

# Gradle cache
.gradle/

# Crash reports
sysinfo.txt

# Mono crash reports
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Addressables build data
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# VS Code
.vscode/